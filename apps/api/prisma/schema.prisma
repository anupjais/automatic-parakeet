generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("user_status")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  name            String     @db.VarChar(100)
  email           String     @unique(map: "users_email_key") @db.VarChar(255)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  role            UserRole   @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)

  addresses Address[]
  cart      Cart?
  wishlist  Wishlist?
  orders    Order[]
  reviews   Review[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}

model Address {
  id           String  @id @default(uuid()) @db.Uuid
  userId       String  @map("user_id") @db.Uuid
  fullName     String  @map("full_name") @db.VarChar(100)
  phone        String  @db.VarChar(20)
  addressLine1 String  @map("address_line_1") @db.VarChar(255)
  addressLine2 String? @map("address_line_2") @db.VarChar(255)
  city         String  @db.VarChar(100)
  state        String  @db.VarChar(100)
  postalCode   String  @map("postal_code") @db.VarChar(20)
  country      String  @db.VarChar(100)
  isDefault    Boolean @default(false) @map("is_default")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId], map: "addresses_user_id_idx")
  @@index([userId, isDefault], map: "addresses_user_default_idx")
  @@map("addresses")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("product_status")
}

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(100)
  slug        String  @unique(map: "categories_slug_key") @db.VarChar(150)
  description String? @db.Text

  parentId String? @map("parent_id") @db.Uuid

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  products Product[]

  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([parentId], map: "categories_parent_id_idx")
  @@index([isActive, sortOrder], map: "categories_active_sort_idx")
  @@map("categories")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @db.VarChar(160)
  slug        String        @unique(map: "products_slug_key") @db.VarChar(180)
  description String?       @db.Text
  status      ProductStatus @default(DRAFT)

  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  variants      ProductVariant[]
  images        ProductImage[]
  wishlistItems WishlistItem[]
  reviews       Review[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([categoryId], map: "products_category_id_idx")
  @@index([status, createdAt], map: "products_status_created_idx")
  @@map("products")
}

model ProductVariant {
  id             String   @id @default(uuid()) @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  sku            String   @unique(map: "product_variants_sku_key") @db.VarChar(100)
  name           String   @db.VarChar(120)
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(12, 2)
  attributes     Json     @default("{}") @db.JsonB
  isActive       Boolean  @default(true) @map("is_active")

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory Inventory?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId], map: "product_variants_product_id_idx")
  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  imageUrl  String  @map("image_url") @db.Text
  altText   String? @map("alt_text") @db.VarChar(255)
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([productId, sortOrder], map: "product_images_product_sort_idx")
  @@map("product_images")
}

model Inventory {
  id                String @id @default(uuid()) @db.Uuid
  variantId         String @unique(map: "inventory_variant_id_key") @map("variant_id") @db.Uuid
  quantity          Int    @default(0)
  reservedQuantity  Int    @default(0) @map("reserved_quantity")
  lowStockThreshold Int    @default(5) @map("low_stock_threshold")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("inventory")
}

model Cart {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique(map: "carts_user_id_key") @map("user_id") @db.Uuid

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("carts")
}

model CartItem {
  id        String @id @default(uuid()) @db.Uuid
  cartId    String @map("cart_id") @db.Uuid
  variantId String @map("variant_id") @db.Uuid
  quantity  Int    @default(1)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([cartId, variantId], map: "cart_items_cart_variant_key")
  @@index([variantId], map: "cart_items_variant_id_idx")
  @@map("cart_items")
}

model Wishlist {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique(map: "wishlists_user_id_key") @map("user_id") @db.Uuid

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("wishlists")
}

model WishlistItem {
  id         String @id @default(uuid()) @db.Uuid
  wishlistId String @map("wishlist_id") @db.Uuid
  productId  String @map("product_id") @db.Uuid

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([wishlistId, productId], map: "wishlist_items_wishlist_product_key")
  @@index([productId], map: "wishlist_items_product_id_idx")
  @@map("wishlist_items")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED

  @@map("order_status")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED

  @@map("payment_status")
}

enum PaymentProvider {
  RAZORPAY
  COD

  @@map("payment_provider")
}

model Order {
  id          String @id @default(uuid()) @db.Uuid
  orderNumber String @unique(map: "orders_order_number_key") @map("order_number") @db.VarChar(50)
  userId      String @map("user_id") @db.Uuid

  status OrderStatus @default(PENDING)

  // Delivery address snapshot
  shippingName       String @map("shipping_name") @db.VarChar(100)
  shippingPhone      String @map("shipping_phone") @db.VarChar(20)
  shippingAddress    String @map("shipping_address") @db.Text
  shippingCity       String @map("shipping_city") @db.VarChar(100)
  shippingState      String @map("shipping_state") @db.VarChar(100)
  shippingPostalCode String @map("shipping_postal_code") @db.VarChar(20)
  shippingCountry    String @map("shipping_country") @db.VarChar(100)

  subtotal    Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  shippingFee Decimal @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  currency    String  @default("INR") @db.VarChar(3)

  notes String? @db.Text

  user     User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  payments Payment[]
  coupon   Coupon?     @relation(fields: [couponId], references: [id])
  couponId String?     @map("coupon_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, createdAt], map: "orders_user_created_idx")
  @@index([status, createdAt], map: "orders_status_created_idx")
  @@map("orders")
}

model OrderItem {
  id        String @id @default(uuid()) @db.Uuid
  orderId   String @map("order_id") @db.Uuid
  variantId String @map("variant_id") @db.Uuid

  // Historical product snapshot
  productName String @map("product_name") @db.VarChar(160)
  variantName String @map("variant_name") @db.VarChar(120)
  sku         String @db.VarChar(100)

  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(12, 2)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([orderId], map: "order_items_order_id_idx")
  @@index([variantId], map: "order_items_variant_id_idx")
  @@map("order_items")
}

model Payment {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid

  provider PaymentProvider
  status   PaymentStatus   @default(PENDING)

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("INR") @db.VarChar(3)

  providerOrderId   String? @map("provider_order_id") @db.VarChar(255)
  providerPaymentId String? @map("provider_payment_id") @db.VarChar(255)
  providerSignature String? @map("provider_signature") @db.Text

  failureReason String?   @map("failure_reason") @db.Text
  paidAt        DateTime? @map("paid_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([orderId], map: "payments_order_id_idx")
  @@index([providerPaymentId], map: "payments_provider_payment_id_idx")
  @@map("payments")
}

enum CouponType {
  PERCENTAGE
  FIXED

  @@map("coupon_type")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("review_status")
}

model Coupon {
  id    String     @id @default(uuid()) @db.Uuid
  code  String     @unique(map: "coupons_code_key") @db.VarChar(50)
  type  CouponType
  value Decimal    @db.Decimal(12, 2)

  minimumOrderAmount Decimal? @map("minimum_order_amount") @db.Decimal(12, 2)
  maximumDiscount    Decimal? @map("maximum_discount") @db.Decimal(12, 2)

  usageLimit Int? @map("usage_limit")
  usageCount Int  @default(0) @map("usage_count")

  startsAt  DateTime? @map("starts_at") @db.Timestamptz(3)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)

  isActive Boolean @default(true) @map("is_active")

  orders Order[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isActive, startsAt, expiresAt], map: "coupons_active_validity_idx")
  @@map("coupons")
}

model Review {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  productId String @map("product_id") @db.Uuid

  rating  Int
  title   String? @db.VarChar(150)
  comment String? @db.Text

  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false) @map("is_verified_purchase")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, productId], map: "reviews_user_product_key")
  @@index([productId, status], map: "reviews_product_status_idx")
  @@map("reviews")
}
